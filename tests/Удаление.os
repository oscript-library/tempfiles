#Использовать asserts
#Использовать ".."

Перем Менеджер;

&ПередКаждым
Процедура СоздатьМенеджер() Экспорт
	Менеджер = Новый МенеджерВременныхФайлов;
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	Менеджер.Удалить();
	Для Каждого Путь Из Менеджер.Файлы() Цикл
		Ожидаем.Что(Новый Файл(Путь).Существует(), Путь).ЭтоЛожь();
	КонецЦикла;
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдалитьФайл")
&ИсточникЗначение("БезопасноУдалитьФайл")
&ИсточникЗначение("УдалитьФайлСИсключением")
Процедура УдаляетсяОтдельныйReadonlyФайл(Метод) Экспорт

	Путь = Менеджер.СоздатьФайл();
	Файл = Новый Файл(Путь);
	Файл.УстановитьТолькоЧтение(Истина);
	Ожидаем.Что(Новый Файл(Путь).ПолучитьТолькоЧтение()).ЭтоИстина();

	ПроверитьУдаление(Метод, Путь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдалитьФайл")
&ИсточникЗначение("БезопасноУдалитьФайл")
&ИсточникЗначение("УдалитьФайлСИсключением")
Процедура УдаляетсяReadonlyКаталогСReadonlyСодержимым(Метод) Экспорт

	Путь = Менеджер.СоздатьКаталог();
	ВложенныйКаталог = ОбъединитьПути(Путь, "вложенный");
	СоздатьКаталог(ВложенныйКаталог);
	Для Каждого Каталог Из СтрРазделить(Путь + "|" + ВложенныйКаталог, "|") Цикл
		Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "файл"));
		Запись.Закрыть();
		Файл = Новый Файл(ОбъединитьПути(Каталог, "файл"));
		Файл.УстановитьТолькоЧтение(Истина);
		Файл = Новый Файл(Каталог);
		Файл.УстановитьТолькоЧтение(Истина);
	КонецЦикла;

	ПроверитьУдаление(Метод, Путь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдалитьФайл")
&ИсточникЗначение("БезопасноУдалитьФайл")
&ИсточникЗначение("УдалитьФайлСИсключением")
Процедура УдаляетсяОбычныйФайл(Метод) Экспорт
	ПроверитьУдаление(Метод, Менеджер.СоздатьФайл());
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдалитьФайл")
&ИсточникЗначение("БезопасноУдалитьФайл")
&ИсточникЗначение("УдалитьФайлСИсключением")
Процедура УдаляетсяПустойReadonlyКаталог(Метод) Экспорт

	Путь = Менеджер.СоздатьКаталог();
	Файл = Новый Файл(Путь);
	Файл.УстановитьТолькоЧтение(Истина);
	ПроверитьУдаление(Метод, Путь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдалитьФайл")
&ИсточникЗначение("БезопасноУдалитьФайл")
&ИсточникЗначение("УдалитьФайлСИсключением")
Процедура ОтсутствующийПутьСчитаетсяУдаленным(Метод) Экспорт
	ПроверитьУдаление(Метод, Менеджер.НовоеИмяФайла());
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдалитьФайл")
&ИсточникЗначение("БезопасноУдалитьФайл")
&ВключенНаОС("Windows", Причина = "Открытый файл блокирует удаление в Windows")
Процедура СовместимыйМетодВозвращаетЛожьДляЗанятогоФайла(Метод) Экспорт

	Путь = Менеджер.СоздатьФайл();
	Чтение = Новый ЧтениеТекста(Путь);

	Попытка
		Ожидаем.Что(ВызватьУдаление(Метод, Путь)).ЭтоЛожь();
		Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

КонецПроцедуры

&Тест
&ВключенНаОС("Windows", Причина = "Открытый файл блокирует удаление в Windows")
Процедура ПробрасываетсяИсходнаяОшибкаУдаленияЗанятогоФайла() Экспорт

	Путь = Менеджер.СоздатьФайл();
	Чтение = Новый ЧтениеТекста(Путь);

	Попытка

		ИсходнаяОшибка = Неопределено;
		Попытка
			УдалитьФайлы(Путь);
		Исключение
			ИсходнаяОшибка = ИнформацияОбОшибке();
		КонецПопытки;
		Ожидаем.Что(ИсходнаяОшибка).Не_().Равно(Неопределено);

		Ошибка = Неопределено;
		Попытка
			Менеджер.УдалитьФайлСИсключением(Путь);
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		Ожидаем.Что(Ошибка).Не_().Равно(Неопределено);
		Ожидаем.Что(Ошибка.ИмяМодуля).Содержит("ВременныеФайлы.os");
		Ожидаем.Что(Ошибка.Описание).Содержит(Путь);

		Пока ИсходнаяОшибка <> Неопределено Цикл
			Ожидаем.Что(Ошибка).Не_().Равно(Неопределено);
			Ожидаем.Что(Ошибка.Описание).Равно(ИсходнаяОшибка.Описание);
			Ошибка = Ошибка.Причина;
			ИсходнаяОшибка = ИсходнаяОшибка.Причина;
		КонецЦикла;
		Ожидаем.Что(Ошибка).Равно(Неопределено);

	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

КонецПроцедуры

&Тест
&ВключенНаОС("Windows", Причина = "Открытый файл блокирует удаление в Windows")
Процедура МассовоеУдалениеСохраняетНеудаленныйПутьДляПовторнойПопытки() Экспорт

	ЗанятыйПуть = Менеджер.СоздатьФайл();
	ReadonlyПуть = Менеджер.СоздатьФайл();
	Файл = Новый Файл(ReadonlyПуть);
	Файл.УстановитьТолькоЧтение(Истина);
	Чтение = Новый ЧтениеТекста(ЗанятыйПуть);

	Попытка
		Менеджер.Удалить();
		Ожидаем.Что(Новый Файл(ReadonlyПуть).Существует()).ЭтоЛожь();
		Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(1);
		Ожидаем.Что(Менеджер.Файлы()[0]).Равно(ЗанятыйПуть);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();
	Менеджер.Удалить();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(0);
	Ожидаем.Что(Новый Файл(ЗанятыйПуть).Существует()).ЭтоЛожь();

КонецПроцедуры

&Тест
&ВключенНаОС("Windows", Причина = "Открытый файл блокирует удаление в Windows")
Процедура НакопительнаяОчисткаСохраняетЗанятыйПутьИПродолжаетУдаление() Экспорт

	СтарыйПуть = Менеджер.СоздатьФайл();
	Снимок = Менеджер.Файлы();
	УдаляемыйПуть = Менеджер.СоздатьФайл();
	ЗанятыйПуть = Менеджер.СоздатьФайл();
	Чтение = Новый ЧтениеТекста(ЗанятыйПуть);

	Попытка
		Менеджер.УдалитьНакопленныеВременныеФайлы(Снимок);
		Ожидаем.Что(Новый Файл(УдаляемыйПуть).Существует()).ЭтоЛожь();
		Ожидаем.Что(Новый Файл(СтарыйПуть).Существует()).ЭтоИстина();
		Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(2);
		Ожидаем.Что(Менеджер.Файлы()[1]).Равно(ЗанятыйПуть);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();
	Менеджер.УдалитьНакопленныеВременныеФайлы(Снимок);
	Ожидаем.Что(Новый Файл(ЗанятыйПуть).Существует()).ЭтоЛожь();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(1);

КонецПроцедуры

Процедура ПроверитьУдаление(Метод, Путь)
	Результат = ВызватьУдаление(Метод, Путь);
	Если Метод <> "УдалитьФайлСИсключением" Тогда
		Ожидаем.Что(Результат).ЭтоИстина();
	КонецЕсли;
	Ожидаем.Что(Новый Файл(Путь).Существует(), Путь).ЭтоЛожь();
КонецПроцедуры

Функция ВызватьУдаление(Метод, Путь)
	Аргументы = Новый Массив;
	Аргументы.Добавить(Путь);
	Рефлектор = Новый Рефлектор;
	Возврат Рефлектор.ВызватьМетод(Менеджер, Метод, Аргументы);
КонецФункции
