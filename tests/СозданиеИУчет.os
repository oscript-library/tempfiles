#Использовать asserts
#Использовать ".."

Перем Менеджер;
Перем ДругойМенеджер;

&ПередКаждым
Процедура СоздатьМенеджеры() Экспорт
	Менеджер = Новый МенеджерВременныхФайлов;
	ДругойМенеджер = Новый МенеджерВременныхФайлов;
КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт
	Менеджер.Удалить();
	ДругойМенеджер.Удалить();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(0);
	Ожидаем.Что(ДругойМенеджер.Файлы().Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура НовыйМенеджерНеСодержитПутей() Экспорт
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура НовоеИмяУникальноИНеСоздаетФайл() Экспорт

	ПервыйПуть = Менеджер.НовоеИмяФайла();
	ВторойПуть = Менеджер.НовоеИмяФайла();
	Ожидаем.Что(ПервыйПуть).Не_().Равно(ВторойПуть);
	Ожидаем.Что(Новый Файл(ПервыйПуть).Расширение).Равно(".tmp");
	Ожидаем.Что(Новый Файл(ПервыйПуть).Существует()).ЭтоЛожь();
	Ожидаем.Что(Новый Файл(ВторойПуть).Существует()).ЭтоЛожь();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(2);
	Ожидаем.Что(Менеджер.Файлы()[0]).Равно(ПервыйПуть);
	Ожидаем.Что(Менеджер.Файлы()[1]).Равно(ВторойПуть);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("tmp")
&ИсточникЗначение("json")
&ИсточникЗначение("")
Процедура ИмяУчитываетРасширение(Расширение) Экспорт
	Путь = Менеджер.НовоеИмяФайла(Расширение);
	Ожидаем.Что(Путь).Не_().Равно("");
	Если Расширение <> "" Тогда
		Ожидаем.Что(Новый Файл(Путь).Расширение).Равно("." + Расширение);
	КонецЕсли;
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("СоздатьФайл", Ложь)
&ИсточникЗначение("СоздатьКаталог", Истина)
Процедура СоздаетсяПустойРесурсПоЗарегистрированномуПути(Метод, ЭтоКаталог) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("data");
	Рефлектор = Новый Рефлектор;
	Путь = Рефлектор.ВызватьМетод(Менеджер, Метод, Аргументы);
	Файл = Новый Файл(Путь);
	Ожидаем.Что(Файл.Существует()).ЭтоИстина();
	Ожидаем.Что(Файл.ЭтоКаталог()).Равно(ЭтоКаталог);
	Ожидаем.Что(Файл.ЭтоФайл()).Равно(Не ЭтоКаталог);
	Ожидаем.Что(Файл.Расширение).Равно(".data");
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(1);
	Ожидаем.Что(Менеджер.Файлы()[0]).Равно(Путь);

	Если ЭтоКаталог Тогда
		Ожидаем.Что(НайтиФайлы(Путь, ПолучитьМаскуВсеФайлы()).Количество()).Равно(0);
	Иначе
		Ожидаем.Что(Файл.Размер()).Равно(0);
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НовоеИмяФайла")
&ИсточникЗначение("СоздатьФайл")
&ИсточникЗначение("СоздатьКаталог")
Процедура ИспользуетсяЗаданныйБазовыйКаталог(Метод) Экспорт

	Каталог = ДругойМенеджер.СоздатьКаталог();
	Менеджер.БазовыйКаталог = Каталог;
	Рефлектор = Новый Рефлектор;
	Путь = Рефлектор.ВызватьМетод(Менеджер, Метод);
	Ожидаем.Что(Новый Файл(Путь).Путь).Равно(Каталог + ПолучитьРазделительПути());
	Ожидаем.Что(Менеджер.Файлы()[0]).Равно(Путь);

КонецПроцедуры

&Тест
Процедура ФайлыВозвращаетНезависимыйСнимок() Экспорт

	Путь = Менеджер.НовоеИмяФайла();
	Снимок = Менеджер.Файлы();
	Снимок.Очистить();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(1);
	Ожидаем.Что(Менеджер.Файлы()[0]).Равно(Путь);
	Снимок = Менеджер.Файлы();
	Менеджер.НовоеИмяФайла();
	Ожидаем.Что(Снимок.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура УдалитьОчищаетТолькоСвойМенеджерИДопускаетПовторныйВызов() Экспорт

	СвойФайл = Менеджер.СоздатьФайл();
	СвойКаталог = Менеджер.СоздатьКаталог();
	Менеджер.НовоеИмяФайла();
	ЧужойФайл = ДругойМенеджер.СоздатьФайл();
	Менеджер.Удалить();
	Менеджер.Удалить();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(0);
	Ожидаем.Что(Новый Файл(СвойФайл).Существует()).ЭтоЛожь();
	Ожидаем.Что(Новый Файл(СвойКаталог).Существует()).ЭтоЛожь();
	Ожидаем.Что(Новый Файл(ЧужойФайл).Существует()).ЭтоИстина();
	Ожидаем.Что(ДругойМенеджер.Файлы().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура УдаляютсяТолькоНакопленныеПослеСнимкаРесурсы() Экспорт

	СтарыйПуть = Менеджер.СоздатьФайл();
	Снимок = Менеджер.Файлы();
	НовыйФайл = Менеджер.СоздатьФайл();
	НовыйКаталог = Менеджер.СоздатьКаталог();
	ReadonlyФайл = Новый Файл(НовыйФайл);
	ReadonlyФайл.УстановитьТолькоЧтение(Истина);
	Менеджер.НовоеИмяФайла();

	Менеджер.УдалитьНакопленныеВременныеФайлы(Снимок);
	Менеджер.УдалитьНакопленныеВременныеФайлы(Снимок);
	Ожидаем.Что(Новый Файл(СтарыйПуть).Существует()).ЭтоИстина();
	Ожидаем.Что(Новый Файл(НовыйФайл).Существует()).ЭтоЛожь();
	Ожидаем.Что(Новый Файл(НовыйКаталог).Существует()).ЭтоЛожь();
	Ожидаем.Что(Снимок.Количество()).Равно(1);
	Ожидаем.Что(Снимок[0]).Равно(СтарыйПуть);
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(1);
	Ожидаем.Что(Менеджер.Файлы()[0]).Равно(СтарыйПуть);

КонецПроцедуры

&Тест
Процедура ПустойСнимокУдаляетВсеНакопленныеРесурсы() Экспорт
	Путь = Менеджер.СоздатьФайл();
	Менеджер.УдалитьНакопленныеВременныеФайлы(Новый Массив);
	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоЛожь();
	Ожидаем.Что(Менеджер.Файлы().Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура КоллекцияКопируетсяВСтруктуруИСоответствие() Экспорт

	Источник = Новый Массив;
	Источник.Добавить("Первый");
	Источник.Добавить("Второй");
	Источник.Добавить("Первый");
	Структура = Новый Структура;
	Структура.Вставить("Первый", "СтароеЗначение");
	Соответствие = Новый Соответствие;
	Менеджер.СкопироватьКоллекцию(Источник, Структура);
	Менеджер.СкопироватьКоллекцию(Источник, Соответствие);
	Менеджер.СкопироватьКоллекцию(Новый Массив, Соответствие);
	Ожидаем.Что(Структура.Количество()).Равно(2);
	Ожидаем.Что(Соответствие.Количество()).Равно(2);
	Для Каждого Ключ Из Источник Цикл
		Ожидаем.Что(Структура[Ключ]).Равно(Ключ);
		Ожидаем.Что(Соответствие[Ключ]).Равно(Ключ);
	КонецЦикла;

КонецПроцедуры
