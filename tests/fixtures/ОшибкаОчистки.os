#Использовать "../.."

Перем Менеджер;
Перем Чтение;
Перем Путь;

&Тест
Процедура ОткрытьФайл() Экспорт
	Менеджер = Новый МенеджерВременныхФайлов;
	Путь = Менеджер.СоздатьФайл("tempfiles-cleanup-error");
	Чтение = Новый ЧтениеТекста(Путь);
КонецПроцедуры

&ПослеКаждого
Процедура ОчиститьФайл() Экспорт

	Попытка
		Менеджер.УдалитьФайлСИсключением(Путь);
	Исключение
		Чтение.Закрыть();
		Менеджер.Удалить();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();
	Менеджер.Удалить();

КонецПроцедуры
