#Использовать asserts
#Использовать ".."
#Использовать autumn
#Использовать oneunit

&Тест
&ВключенНаОС("Windows", Причина = "Открытый файл блокирует удаление в Windows")
Процедура РезультатOneUnitСодержитПричинуСбояОчистки() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures"));
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "ОшибкаОчистки");
	Совет = Новый СоветДругогоМастера;
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();
	Статистика = Поделка.НайтиЖелудь("РепортерСтатистика");

	Ожидаем.Что(План.Дети().Количество()).Равно(1);
	Набор = План.Дети().Получить(0);
	Ожидаем.Что(Набор.Дети().Количество()).Равно(1);
	Результат = Статистика.Результат(Набор.Дети().Получить(0));
	Ожидаем.Что(Результат.Состояние()).Не_().Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(Результат.Причины().Количество()).Больше(0);
	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));
	Ожидаем.Что(Описание).Содержит(".tempfiles-cleanup-error");
	Ожидаем.Что(Описание).Содержит("ВременныеФайлы.os");
	Ожидаем.Что(Описание).Содержит("System.IO.IOException");

КонецПроцедуры
